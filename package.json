{
  "name": "@u1f992/vivliostyle-index",
  "version": "0.2.4",
  "description": "unified plugin that integrates automatic index generation into Vivliostyle CLI workflows.",
  "main": "dist/index.js",
  "scripts": {
    "lint": "oxlint --fix src",
    "format": "oxfmt src",
    "build": "tsc && tsc --noEmit --ignoreConfig oxfmt.config.ts oxlint.config.ts",
    "test": "node --test \"dist/**/*.test.js\"",
    "example": "cd example && npx vivliostyle preview"
  },
  "keywords": [],
  "author": "Koutaro Mukai",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/u1f992/vivliostyle-index"
  },
  "type": "module",
  "devDependencies": {
    "@types/hast": "^2.3.10",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "unified": "^9.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "hast-util-from-html": "^1.0.2",
    "hast-util-get-attribute": "^1.0.0",
    "hast-util-get-xpath": "^1.0.0",
    "hast-util-select": "^5.0.5",
    "hast-util-to-text": "^3.1.2",
    "upath": "^2.0.1",
    "yaml": "^2.8.1"
  }
}
